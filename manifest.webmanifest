{
  "name": "Progress Hub",
  "short_name": "Progress Hub",
  "description": "Personal KPI tracker: CSAT, AR and AHT.",
  "id": "./",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d0f12",
  "theme_color": "#0d0f12",
  "categories": ["productivity", "business"],
  "icons": [
    {"src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/icon512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
